PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/securevault
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Development Admin Test Account Configuration
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@securevault.local
ADMIN_PASSWORD=your_secure_admin_password_min_8_chars

# Supabase Storage Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key_change_in_production
SUPABASE_BUCKET=securevault-documents

# Document Encryption Configuration (AES-256-GCM)
DOCUMENT_ENCRYPTION_KEY=your_base64_encoded_32_byte_aes_key
DOCUMENT_ENCRYPTION_KEY_VERSION=1
